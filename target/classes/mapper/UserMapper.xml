<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.tom.dao.UserMapper" >

    <select id="findOneIf" resultType="cn.tom.entity.User">
        select *
        from t_user
        Where 1=1
        <if test="id!=null">AND id=#{id}</if>
        <if test="account!=null and account!=''">AND account=#{account}</if>
        <if test="phone!=null and phone!=''">AND phone=#{phone}</if>
    </select>

    <insert id="addUser" parameterType="cn.tom.entity.UserP">
        insert into t_user(account,password,role,phone,nickname,vip,addr,img,closed)
        values (#{account},#{password},#{role},#{phone},#{nickname},#{vip},#{addr},#{img},#{closed})
    </insert>

    <update id="updateUser" parameterType="cn.tom.entity.UserP">
        update t_user
        <set>
            <if test="nickname != null and nickname!=''">nickname = #{nickname},</if>
            <if test="addr != null and addr!=''">addr = #{addr},</if>
            <if test="phone != null and phone!=''">phone = #{phone},</if>
            <if test="password != null and password!=''">password = #{password},</if>
        </set>
        where id=#{id}
    </update>

    <update id="updateImg" parameterType="map">
        update t_user
        <set>
            <if test="img != null and img!=''">img = #{img},</if>
        </set>
        where id=#{id}
    </update>
</mapper>