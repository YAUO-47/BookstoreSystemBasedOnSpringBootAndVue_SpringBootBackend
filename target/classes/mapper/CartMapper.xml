<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.tom.dao.CartMapper" >

    <resultMap id="orderMap" type="cn.tom.entity.Cart">
        <id column="id" property="id"></id>
        <result column="uid" property="uid"></result>
        <result column="num" property="num"></result>
        <result column="price" property="price"></result>
        <result column="tcreate" property="tcreate"></result>
        <association property="book">
            <result column="bid" property="id"></result>
            <result column="name" property="name"></result>
            <result column="sn" property="sn"></result>
            <result column="price" property="price"></result>
            <result column="maker" property="maker"></result>
            <result column="tmake" property="tmake"></result>
            <result column="pic" property="pic"></result>
            <result column="author" property="author"></result>
            <result column="salenum" property="salenum"></result>
            <result column="stock" property="stock"></result>
            <result column="info" property="info"></result>
            <association property="type">
                <result column="id" property="id"></result>
                <result column="tname" property="name"></result>
            </association>
        </association>
    </resultMap>

    <select id="findAllCartByUid" parameterType="int" resultMap="orderMap">
        SELECT a.id,a.uid,a.num,a.price,a.tcreate,b.name,b.id AS bid,b.sn,
         b.price,b.maker,b.tmake,b.typeid,b.pic,b.author,b.salenum,b.stock,b.info
         FROM t_cart a,t_book b
         WHERE a.bookid = b.id
         AND a.uid = #{uid}
    </select>

    <insert id="addCart" parameterType="cn.tom.entity.Cart">
        insert into t_cart(uid,bookid,num,price,tcreate)
        values (#{uid},#{book.id},#{num},#{price},#{tcreate})
    </insert>

    <update id="updateCart" parameterType="cn.tom.entity.Cart">
        update t_cart
        <set>
            <if test="num != null">num = #{num},</if>
            <if test="price != null">price = #{price},</if>
        </set>
        where id=#{id}
    </update>

    <select id="findCartOne" parameterType="int" resultType="cn.tom.entity.Cart">
        SELECT * FROM t_cart
        WHERE  bookid = #{bookid}
        AND uid = #{uid}
    </select>

    <delete id="removeCart"  parameterType="int">
        delete from t_cart Where id=#{id}
    </delete>
</mapper>